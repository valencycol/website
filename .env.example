# ─────────────────────────────────────────────────────────────
#  colaco.se — secrets
#  This file is gitignored. It is NOT read by the website.
#  It is the local copy of the secrets you push to Cloudflare:
#
#     npx wrangler secret put GROQ_API_KEY --name colaco-chat
#
#  Paste your key below, then run the command above.
# ─────────────────────────────────────────────────────────────

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Model served by Groq. openai/gpt-oss-20b is the 20B open-weight model.
GROQ_MODEL=openai/gpt-oss-20b
