{
  // Deploy config for the chat worker.
  //
  //   wrangler deploy                     -> colaco-chat  (uses this file)
  //   wrangler deploy feeds-worker.js --name colaco-feeds --no-bundle
  //
  // Declaring the KV binding here matters: `wrangler deploy` sends complete
  // worker metadata, so a binding added only in the dashboard is REMOVED by
  // the next deploy. Anything the worker needs belongs in this file.
  "name": "colaco-chat",
  "compatibility_date": "2026-08-28",
  "main": "chat-worker.js",

  // Per-IP rate limiting. Without this binding the worker still runs, it
  // just does not throttle — see rateLimit() in chat-worker.js.
  "kv_namespaces": [
    {
      "binding": "CHAT_RL",
      "id": "ca133c3ff0a1472485197d9d4d6f95dd"
    }
  ],

  // Weekly digest of what visitors asked. Monday 08:00 UTC.
  "triggers": { "crons": ["0 8 * * 1"] },

  // Email Routing's send binding — free, and colaco.se already has
  // valency007@gmail.com verified as a destination. Email SERVICE (the
  // nicer object API) needs a Workers Paid plan, hence the raw-MIME path
  // in sendDigest().
  //
  // destination_address locks the binding to one recipient: even if the
  // worker were compromised it could not be turned into a spam relay.
  "send_email": [{ "name": "EMAIL", "destination_address": "valency007@gmail.com" }],

  "observability": { "enabled": true }
}
